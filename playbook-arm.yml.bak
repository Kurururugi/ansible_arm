---
- name: ARM Settings
  hosts: arm
  become: yes
  become_user: root
  vars:
    iso_name: installation-1.8.5.46-11.02.26_01.30-di.iso
    project_dir: /usr/local/Project
    install_dir: /usr/local/Project/install
    repository_dir: /usr/local/alse
  tasks:

### create directores for new project ###

    - name: create directory /usr/local/Project
      shell: "mkdir -p {{ project_dir }}"

    - name: rights to the Project folder
      shell: "chmod 0777 -R {{ project_dir }}"

    - name: create directory for install
      shell: "mkdir -p {{ install_dir }}"

    - name: rights to the install folder
      shell: "chmod 0755 -R {{ install_dir }}"


### install ConfigUpdater-3.2.tar.gz for python3 ###

    - name: copy ConfigUpdater-3.2.tar.gz
      copy:
        src: '{{ install_dir }}/ConfigUpdater-3.2.tar.gz'
        dest: /usr/local/Project/install/ConfigUpdater-3.2.tar.gz
        owner: root
        group: root
        mode: '0644'

    - name: untar ConfigUpdater-3.2.tar.gz
      shell: 'tar -C {{ install_dir }} -xvf {{ install_dir }}/ConfigUpdater-3.2.tar.gz'

    - name: rm /usr/local/Project/install/ConfigUpdater-3.2.tar.gz
      file:
        path: '{{ install_dir }}/ConfigUpdater-3.2.tar.gz'
        state: absent

    - name: install ConfigUpdater-3.2
      command: python3 setup.py install
      args:
        chdir: /usr/local/Project/install/ConfigUpdater-3.2

    - name: delete /usr/local/Project/install/ConfigUpdater-3.2
      file:
        path: '{{ install_dir }}/ConfigUpdater-3.2'
        state: absent

### install lxml 6.0.2 ###

    - name: copy lib for lxml
      copy:
        src: '{{ install_dir }}/lib_for_lxml.tar'
        dest: /usr/local/Project/install/lib_for_lxml.tar
        owner: root
        group: root
        mode: '0644'

    - name: untar lib_for_lxml.tar
      shell: 'tar -C {{ install_dir }} -xvf {{ install_dir }}/lib_for_lxml.tar'

    - name: rm lib_for_lxml.tar
      file:
        path: '{{ install_dir }}/lib_for_lxml.tar'
        state: absent

    - name: install lib for lxml
      shell: 'dpkg -i {{ install_dir }}/lib_for_lxml/*.deb'

    - name: delete install directory lib for lxml
      file:
        path: '{{ install_dir }}/lib_for_lxml'
        state: absent

    - name: copy lxml-6.0.2.tar.gz
      copy:
        src: '{{ install_dir }}/lxml-6.0.2.tar.gz'
        dest: /usr/local/Project/install/lxml-6.0.2.tar.gz
        owner: root
        group: root
        mode: '0644'

    - name: untar lxml-6.0.2.tar.gz
      shell: 'tar -C {{ install_dir }} -xvf {{ install_dir }}/lxml-6.0.2.tar.gz'

    - name: rm /usr/local/Project/install/lxml-6.0.2.tar.gz
      file:
        path: '{{ install_dir }}/lxml-6.0.2.tar.gz'
        state: absent

    - name: build lxml-6.0.2
      command: python3 setup.py build
      args:
        chdir: /usr/local/Project/install/lxml-6.0.2

    - name: install lxml-6.0.2
      command: python3 setup.py install
      args:
        chdir: /usr/local/Project/install/lxml-6.0.2

    - name: delete diretory lxml-6.0.2
      file:
        path: '{{ install_dir }}/lxml-6.0.2'
        state: absent

### create local repository ###

    - name: copy iso
      copy:
        src: '{{ install_dir }}/{{ iso_name }}'
        dest: '{{ install_dir }}/{{ iso_name }}'

    - name: mount iso
      shell: 'mkdir -p /mnt/iso && sudo mount {{ install_dir }}/{{ iso_name }} /mnt/iso'

    - name: create repository
      shell: "mkdir -p {{ repository_dir }} && sudo cp -r /mnt/iso {{ repository_dir }}"

    - name: umount iso
      shell: "umount /mnt/iso"

    - name: add repository
      script: /usr/local/Project/scripts/python/repository.py

### xorg settings ###

    - name: run script xorg.sh
      script: /usr/local/Project/scripts/shell/xorg.sh

### copy iptables scripts ###

    - name: copy stop_iptables.sh
      copy:
        src: '{{ project_dir }}/files/userscripts/stop_iptables.sh'
        dest: /usr/local/Project/stop_iptables.sh
        owner: root
        group: root
        mode: '0755'

    - name: copy start_iptables.sh
      copy:
        src: '{{ project_dir }}/files/userscripts/start_iptables.sh'
        dest: /usr/local/Project/start_iptables.sh
        owner: root
        group: root
        mode: '0755'

    - name: copy nochmod_disable.sh
      copy:
        src: '{{ project_dir }}/files/userscripts/nochmod_disable.sh'
        dest: /usr/local/Project/nochmod_disable.sh
        owner: root
        group: root
        mode: '0755'

### default users settings ###

    - name: /usr/share/fly-wm/theme/default.themerc and /usr/share/fly-wm/theme/default.themerc.fly-kiosk
      script: /usr/local/Project/scripts/python/defaul_user_settings.py

    - name: usr/share/fly-wm/keyshortcutrc.fly-kiosk
      script: /usr/local/Project/scripts/shell/keyshortcutrc.sh

    - name: backup /usr/share/fly-wm/ru_RU.UTF-8.miscrc.fly-kiosk
      shell: 'cp /usr/share/fly-wm/ru_RU.UTF-8.miscrc.fly-kiosk /usr/share/fly-wm/ru_RU.UTF-8.miscrc.fly-kiosk.bak'

    - name: copy /usr/share/fly-wm/ru_RU.UTF-8.miscrc.fly-kiosk
      copy:
        src: /usr/local/Project/files/ru_RU.UTF-8.miscrc.fly-kiosk
        dest: /usr/share/fly-wm/ru_RU.UTF-8.miscrc.fly-kiosk
        owner: root
        group: root
        mode: '0644'

### create new users ###

    - name: execute script create_users.py
      script: /usr/local/Project/scripts/python/create_users.py

    - name: copy /home/operator_arm/.fly
      copy:
        src: /usr/local/Project/files/operator_arm/.fly/
        dest: /home/operator_arm/.fly/
        owner: operator_arm
        group: operator_arm
        directory_mode:

    - name: copy fly-kiosk for operator_arm
      copy:
        src: /usr/local/Project/files/fly-kiosk/operator_arm/
        dest: /etc/fly-kiosk/operator_arm/
        owner: root
        group: operator_arm
        directory_mode:

    - name: chown /etc/fly-kiosk/operator_arm/fly-kiosk.conf
      shell: "chown root:root /etc/fly-kiosk/operator_arm/fly-kiosk.conf"

    - name: run script kiosk.py
      script: /usr/local/Project/scripts/python/kiosk.py

    - name: PASS_MAX_DAYS for administrator
      shell: "chage -M 730 administrator"

    - name: PASS_MAX_DAYS for operator_arm
      shell: "chage -M 730 operator_arm"

    - name: execute script create_start_hmi.py
      script: /usr/local/Project/scripts/python/create_start_hmi.py

    - name: copy /home/operator_arm/.config
      copy:
        src: /usr/local/Project/files/operator_arm/.config/
        dest: /home/operator_arm/.config/
        owner: operator_arm
        group: operator_arm
        directory_mode:

    - name: copy /home/administrator/.config/powermanagementprofilesrc
      copy:
        src: /usr/local/Project/files/powermanagementprofilesrc
        dest: /home/administrator/.config/powermanagementprofilesrc
        owner: administrator
        group: administrator
        mode: '0600'

    - name: copy /home/operator_arm/.config/powermanagementprofilesrc
      copy:
        src: /usr/local/Project/files/powermanagementprofilesrc
        dest: /home/operator_arm/.config/powermanagementprofilesrc
        owner: operator_arm
        group: operator_arm
        mode: '0600'

### audit settings ###

    - name: backup old logrotate.conf
      shell: 'mv /etc/logrotate.conf /etc/logrotate.conf.bak'

    - name: copy logrotate.conf
      copy:
        src: /usr/local/Project/files/logrotate.conf
        dest: /etc/logrotate.conf
        owner: root
        group: root
        mode: '0644'

    - name: copy audit01.rules
      copy:
        src: /usr/local/Project/files/audit01.rules
        dest: /etc/audit/rules.d/audit01.rules
        owner: root
        group: root
        mode: '0644'

    - name: copy /etc/audit/files/auditd.conf
      copy:
        src: /usr/local/Project/files/auditd.conf
        dest: /etc/audit/auditd.conf
        owner: root
        group: root
        mode: '0644'

    - name: copy /etc/audit/5-exclude.rules
      copy:
        src: /usr/local/Project/files/5-exclude.rules
        dest: /etc/audit/rules.d/5-exclude.rules
        owner: root
        group: root
        mode: '0644'

    - name: create user's audit
      shell: "useraud -o 0:0"

    - name: create admin's audit
      shell: "useraud administrator 0:0"

    - name: restart auditd.service
      systemd:
        name: auditd
        enabled: yes
        state: restarted

    - name: logrotate settings
      script: /usr/local/Project/scripts/python/logrotate.py

    - name: create file finalize audit
      script: /usr/local/Project/scripts/shell/audit-finalize.sh

### snmp ###

    - name: install snmpd
      apt:
        name: snmpd
        state: present

    - name: execute script snmpd.py
      script: /usr/local/Project/scripts/python/snmpd.py

### chrony ###

    - name: install chrony
      apt:
        name: chrony
        state: present

    - name: execute script chrony.py
      script: /usr/local/Project/scripts/python/chrony.py

### grub settings ###

    - name: grub settings
      script: /usr/local/Project/scripts/python/grub.py

### ssh settings ###

    - name: ssh Settings
      script: /usr/local/Project/scripts/python/ssh.py

### fscontrol ###

    - name: copy fscontrol files
      copy:
        src: '{{ install_dir }}/FSControl'
        dest: /usr/local/Project/install/
        owner: root
        group: root
        mode: '0755'

    - name: install libicu70_70.1-2_amd64.deb
      shell: 'dpkg -i {{ install_dir }}/FSControl/libicu70_70.1-2_amd64.deb'

    - name: install libssl1.1_1.1.1f-1ubuntu2.24_amd64.deb
      shell: 'dpkg -i {{ install_dir }}/FSControl/libssl1.1_1.1.1f-1ubuntu2.24_amd64.deb'

    - name: install FSControl.1.0.37.linux-x64.deb
      shell: 'dpkg -i {{ install_dir }}/FSControl/FSControl.1.0.37.linux-x64.deb'

    - name: untar aspnetcore-runtime-8.0.13-linux-x64.tar.gz
      shell: 'tar -C /opt/FSControl -xvf {{ install_dir }}/FSControl/aspnetcore-runtime-8.0.13-linux-x64.tar.gz'

    - name: chmod for /etc/systemd/system/FSControl.service
      shell: 'chmod 644 /etc/systemd/system/FSControl.service'

    - name: run script fscontrol-service.py
      script: /usr/local/Project/scripts/python/fscontrol-service.py

    - name: create directory /opt/FSControlUI
      shell: 'mkdir -p /opt/FSControlUI'

    - name: FSControl.ElectronApp-2.0.0.AppImage in /opt/FSControlUI
      shell: 'cp {{ install_dir }}/FSControl/FSControl.ElectronApp-2.0.0.AppImage /opt/FSControlUI/'

    - name: chmod FSControl.ElectronApp-2.0.0.AppImage
      shell: 'chmod +x /opt/FSControlUI/FSControl.ElectronApp-2.0.0.AppImage'

    - name: create group fscontrol
      shell: 'groupadd fscontrol'

    - name: administrator in fscontrol group
      shell: 'usermod -aG fscontrol administrator'

    - name: chmod /opt/FSControl/appsettings_unix.json
      shell: 'chmod 644 /opt/FSControl/appsettings_unix.json'

    - name: run script fscontrol-json.py
      script: /usr/local/Project/scripts/python/fscontrol-json.py

    - name: enable FSControl.service
      shell: 'systemctl enable FSControl.service'

    - name: start FSControl.service
      shell: 'systemctl start FSControl.service'

    - name: delete install directory FSControll
      file:
        path: '{{ install_dir }}/FSControl'
        state: absent

### clear bash history ###

    - name: run script rm_bash_history.sh
      script: /usr/local/Project/scripts/shell/rm_bash_history.sh

### visudo ###

    - name: run script visudo.py
      script: /usr/local/Project/scripts/python/visudo.py

### usbguard ###

    - name: install usbguard
      apt:
        name: usbguard
        state: present

    - name: enable usbguard
      shell: "systemctl enable usbguard"

    - name: start usbguard
      shell: "systemctl start usbguard"

    - name: run script usdguard.py
      script: /usr/local/Project/scripts/python/usdguard.py

    - name: run script usdguard_rule.py
      script: /usr/local/Project/scripts/python/usdguard_rule.py

### disable autoupdate ###

    - name: run script disable_autoupdate.py
      script: /usr/local/Project/scripts/python/disable_autoupdate.py

### delete autostart ###

    - name: run script autostart_arm.sh
      script: /usr/local/Project/scripts/shell/autostart_arm.sh

### disable IPv6  ###

    - name: run script sysctl.py
      script: /usr/local/Project/scripts/python/sysctl.py

### pam.d settings ###

    - name: run script pam.py
      script: /usr/local/Project/scripts/python/pam.py

### admin settings ###

    - name: run script admin_settings.py
      script: /usr/local/Project/scripts/python/admin_settings.py

### settings for virtual keyboard ###

    - name: run script fly-vkbd.py
      script: /usr/local/Project/scripts/python/fly-vkbd.py

### autostart ###

    - name: run script fly-dmrc.py
      script: /usr/local/Project/scripts/python/fly-dmrc.py

### disable sudo -i  ###

    - name: run script root.py
      script: /usr/local/Project/scripts/python/root.py

### kernel protect  ###

    - name: run kernel_protect.py
      script: /usr/local/Project/scripts/python/kernel_protect.py

### checkOS  ###

    - name: copy /usr/local/Project/install/CheckOS_AstraLinux_v.2.4.3
      copy:
        src: /usr/local/Project/install/CheckOS_AstraLinux_v.2.4.3
        dest: /opt
        owner: root
        group: root
        mode: '0755'

    - name: chmod +x checkOS
      shell: 'chmod +x /opt/CheckOS_AstraLinux_v.2.4.3/checkOS_Astra'

### install kics ###

    - name: copy /usr/local/Project/install/kics/
      copy:
        src: /usr/local/Project/install/kics
        dest: /usr/local/Project/install/
        owner: root
        group: root
        mode: '0755'

    - name: install kics
      shell: 'dpkg -i {{ install_dir }}/kics/kics_1.3.0-1206_amd64.deb'

    - name: create dir for update
      shell: 'mkdir /opt/kics_update'

    - name: chmod for /opt/kics_update
      shell: 'chmod 755 -R /opt/kics_update'

    - name: kics postinstall
      shell: '/opt/kaspersky/kics/bin/kics-setup.pl --autoinstall={{ install_dir }}/kics/autoinstall.ini'

    - name: install kics-gui
      shell: 'dpkg -i {{ install_dir }}/kics/kics-gui_1.3.0-1206_amd64.deb'

    - name: mv /opt/kaspersky/kics/lib64/libstdc++.so.6
      shell: 'mv /opt/kaspersky/kics/lib64/libstdc++.so.6 /opt/kaspersky/kics/lib64/libstdc++.so.6.old'

    - name: kics settings
      shell: 'kics-control --import-settings --file /usr/local/Project/install/kics/kics_1_3_ttr.ini'

    - name: run script kics_audit.py
      script: /usr/local/Project/scripts/python/kics_audit.py

### install alpha.hmi ###

    - name: copy alpha.tar
      copy:
        src: '{{ install_dir }}/alpha.tar'
        dest: /usr/local/Project/install/alpha.tar
        owner: root
        group: root
        mode: '0644'

    - name: untar alpha.tar
      shell: 'tar -C {{ install_dir }} -xvf {{ install_dir }}/alpha.tar'

    - name: rm alpha.tar
      file:
        path: '{{ install_dir }}/alpha.tar'
        state: absent

    - name: install alpha deb
      shell: 'dpkg -i {{ install_dir }}/AlphaPlatform/*.deb'

    - name: install slapd
      apt:
        name:
          - slapd
          - ldap-utils
        state: present
        update_cache: yes

    - name: copy slapd.preseed
      copy:
        src: '{{ project_dir }}/files/slapd.preseed'
        dest: /usr/local/Project/slapd.preseed
        owner: root
        group: root
        mode: '0644'

    - name: debconf-set-selection
      shell: 'debconf-set-selections < /usr/local/Project/slapd.preseed'

    - name: reconfigure slapd
      shell: 'DEBIAN_FRONTEND=noninteractive dpkg-reconfigure slapd'

    - name: delete slapd.preseed
      file:
        path: '/usr/local/Project/slapd.preseed'
        state: absent

    - name: run script alpha.security.schema.export.sh
      command: sh ./alpha.security.schema.export.sh
      args:
        chdir: /opt/Automiq/Alpha.Security/

    - name: run script alpha.security.py
      script: '{{ project_dir }}/scripts/python/alpha.security.py'

    - name: ldapadd access.ldif
      command: ldapadd -Y EXTERNAL -H ldapi:/// -f access.ldif
      args:
        chdir: /opt/Automiq/Alpha.Security/

    - name: restart OpenLDAP Service
      shell: 'systemctl restart slapd.service'

    - name: enable OpenLDAP Service
      shell: 'systemctl enable slapd.service'

    - name: run script alpha.security.ic.py
      script: '{{ project_dir }}/scripts/python/alpha.security.ic.py'

    - name: run script alpha_start_hmi.py
      script: '{{ project_dir }}/scripts/python/alpha_start_hmi.py'


### other settings ###

    - name: run script other_settings.sh
      script: /usr/local/Project/scripts/shell/other_settings.sh

...
